{
    "name": "ton-universal-wallet",
    "version": "2.0.0",
    "description": "Decentralized wallet system with V3R1, V3R2, V4R2, V5R1, and Highload V3 support",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "type-check": "tsc --noEmit",
        "find:real-address": "node scripts/find-real-address.mjs",
        "type-check:strict": "tsc -p tsconfig.strict.json --noEmit"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@ston-fi/api": "^0.32.0",
        "@ston-fi/sdk": "^2.7.0",
        "@ton/core": "^0.63.1",
        "@ton/crypto": "^3.3.0",
        "@ton/ton": "^16.2.2",
        "@tonconnect/protocol": "^3.0.0",
        "@types/qrcode": "^1.5.5",
        "buffer": "^6.0.3",
        "cheerio": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "docx": "^9.6.0",
        "framer-motion": "^12.34.0",
        "html-to-docx": "^1.8.0",
        "lucide-react": "^0.562.0",
        "process": "^0.11.10",
        "puppeteer": "^24.37.5",
        "qrcode": "^1.5.4",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "tailwind-merge": "^3.4.0",
        "tweetnacl": "^1.0.3",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/react": "^19.2.9",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "autoprefixer": "^10.4.23",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.3.2",
        "vite": "^5.0.0",
        "vite-plugin-node-polyfills": "^0.22.0",
        "vitest": "^1.0.0"
    }
}

# TonAPI Key - Get from https://tonconsole.com
VITE_TONAPI_KEY=

# Toncenter API Key - Get from https://toncenter.com or @tonapibot on Telegram
VITE_TONCENTER_API_KEY=

# =============================================================================
# HOW TO GET API KEYS
# =============================================================================
#
# TonAPI:
#   1. Go to https://tonconsole.com
#   2. Create an account
#   3. Generate an API key
#   4. Copy the key to VITE_TONAPI_KEY
#
# Toncenter:
#   1. Open Telegram
#   2. Search for @tonapibot
#   3. Send /start
#   4. Request an API key
#   5. Copy the key to VITE_TONCENTER_API_KEY
#
# For production (high traffic):
#   - Consider TonAPI Pro plan for higher rate limits
#   - Get multiple API keys for load balancing
#   - Use dedicated RPC nodes for mission-critical apps

# =============================================================================
# OPTIONAL: Backup API Keys (for failover)
# =============================================================================

# Second TonAPI key for load balancing (optional)
# VITE_TONAPI_KEY_2=your_backup_tonapi_key

# Second Toncenter key for load balancing (optional)
# VITE_TONCENTER_API_KEY_2=your_backup_toncenter_key
